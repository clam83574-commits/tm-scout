# Регенерируемые выгрузки мирового размера. candidates.json на полном обходе
# весит 108 МиБ - это выше ЖЁСТКОГО предела GitHub в 100 МиБ на файл, и пуш
# отклоняется целиком. Ни один из двух файлов никто не читает: d1-import.sql
# заливается в D1 в том же прогоне, где создан, а JSON - запасной корм для
# бота на случай жизни без SQL, который не используется. Доставка идёт через
# D1, сохранность - через артефакты прогона (30 дней). В git остаётся то,
# что человек может открыть: diff, счётчики, события и CSV.
out/candidates.json
out/d1-import.sql
# Выгрузка таблицы из D1 (~95 МиБ) и рассчитанная по ней разница - живут
# только внутри прогона, см. d1sync.py.
out/remote-players.sql
out/d1-sync.sql
